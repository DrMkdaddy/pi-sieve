{
  "name": "@drmkdaddy/pi-sieve",
  "version": "0.2.0",
  "description": "Context-engineering, semantic routing, hybrid Jev compaction, durable tabs, and guardrail suite for the Pi coding agent",
  "license": "MIT",
  "type": "module",
  "author": "Noor Mkdad <noorhayatywadam@gmail.com>",
  "homepage": "https://github.com/DrMkdaddy/pi-sieve",
  "repository": {
    "type": "git",
    "url": "git@github.com:DrMkdaddy/pi-sieve.git"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "context-engineering",
    "model-router",
    "compaction",
    "jev",
    "sieve"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "bench": "node bench/compaction-bench.mjs",
