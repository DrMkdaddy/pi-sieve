    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/sieve-compaction.ts",
      "./extensions/sieve-router.ts",
      "./extensions/sieve-tabs.ts",
      "./extensions/sieve-status.ts",
      "./extensions/sieve-handoff.ts",
      "./extensions/sieve-guardrails.ts",
      "./extensions/sieve-ergo.ts"
    ]
  }
}
